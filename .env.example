# meme-search-telegram-bot configuration. Copy to .env and fill in.
# Every variable can also be set in config.yml (see config.example.yml); env vars win over the file.
# Empty values are the same as unset. Durations use Go syntax: 10s, 5m, 6h.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Telegram bot token from @BotFather (/newbot). Also enable inline mode there (/setinline) if you want
# inline search. Required, no default.
# Example: 123456789:AAE-your-token-here
TELEGRAM_BOT_TOKEN=

# Base URL of your meme-search instance, without a trailing path. Required, no default.
# Examples: https://memes.example.com, http://meme_search:3000 (inside the meme-search compose network;
# docker-compose.meme-search.yml sets this for you)
MEME_SEARCH_URL=

# meme-search API token (Settings -> API tokens). Required, no default.
# Needed scopes: search:read,media:read (the bot only reads). Name it e.g. telegram-bot.
MEME_SEARCH_API_TOKEN=

# Timeout for one request to the meme-search API (Go duration). Optional, default 30s.
# MEME_SEARCH_TIMEOUT=30s

# ---------------------------------------------------------------------------
# Search
# ---------------------------------------------------------------------------

# How many memes the bot sends per search page. Optional, default 5.
RESULTS_PER_PAGE=5

# Search mode passed to meme-search: vector (semantic, default) or keyword. Optional.
SEARCH_MODE=vector

# How many memes one inline query asks meme-search for, 1-20. Results not cached on Telegram yet are queued
# for upload, so a small number keeps the upload queue short. Optional, default 3.
INLINE_RESULTS=3

# Telegram sends an inline query on nearly every keystroke. Each one waits this long; if the same user typed
# more meanwhile, the older query is dropped without a search. At most 5s (Telegram expires inline queries
# after about 10s), 0 disables it. Optional, default 1s.
INLINE_DEBOUNCE=1s

# Default scope of inline queries typed in groups, as filters: #tag (at most 10) and dir:folder. Used only when
# neither the query nor the user's /settings name tags. Telegram does not say which group a query comes from,
# only that it is a group. Optional, default empty. Example: #reaction #work
INLINE_GROUP_SCOPE=

# ---------------------------------------------------------------------------
# Media cache and inline mode
# ---------------------------------------------------------------------------

# Id of a private Telegram channel used as a file cache, so every meme is uploaded to Telegram only once.
# Inline mode (@bot query in any chat) needs it: with it empty, inline mode is off and there is no warmup.
# Optional, default empty. How to get it: create a private channel, add the bot as an admin, then forward
# any message from the channel to @userinfobot (or open the channel in Telegram Web: the number in the URL
# with -100 in front). The id looks like -1001234567890.
CACHE_CHAT_ID=

# Folder with meme-search images, scanned to pre-upload files into the cache channel (warmup) and to match
# API results to local files by name. Optional, default: the value of SAVE_DIR. In Docker it is /memes.
# LIBRARY_DIR=/memes

# How often the library folder is rescanned for new or changed files. Optional, default 6h.
WARMUP_INTERVAL=6h

# Total uploads per minute into the cache channel (user-triggered and warmup together). Telegram throttles
# bots that upload too fast, so keep it modest. Optional, default 20.
CACHE_UPLOADS_PER_MIN=20

# Cap for background warmup uploads per minute, so warmup never starves live requests. Optional, default 10.
WARMUP_UPLOADS_PER_MIN=10

# ---------------------------------------------------------------------------
# Saving memes sent to the bot
# ---------------------------------------------------------------------------

# Folder where received memes are saved, in subfolders chosen by SAVE_MODE. Point it at a folder
# meme-search reads. Optional, default: memes/ next to the executable (in Docker: /memes, set by the image).
# SAVE_DIR=/memes

# How saved memes are split into subfolders:
#   per_user - one subfolder per user, <SAVE_DIR_PREFIX><username>/ (register each one in meme-search)
#   single   - one subfolder SAVE_FOLDER/ for everybody (register it once; the same meme is saved once)
# Optional, default per_user.
SAVE_MODE=per_user

# The subfolder of single mode: letters, digits, - and _ only. Ignored in per_user mode. Optional, default telegram.
SAVE_FOLDER=telegram

# Prefix of per-user subfolders (per_user mode only). Register each folder in meme-search Settings -> Image paths
# by its bare name. Optional, default tg-. Example: with tg- a user "alice" gets tg-alice/.
SAVE_DIR_PREFIX=tg-

# Extra text appended to the "Saved" reply, e.g. when the meme will show up in search. Optional, default empty.
# Example: Indexing takes a few minutes, then it is searchable.
SAVE_NOTE=

# Comma-separated Telegram user ids allowed to save memes. They are also trusted (unlimited search).
# Saving is off when empty. Optional, default empty. Find your id with @userinfobot. Example: 111111,222222
SAVE_USER_IDS=

# ---------------------------------------------------------------------------
# Access and limits
# ---------------------------------------------------------------------------

# Comma-separated user ids with unlimited search (without the right to save). Optional, default empty.
TRUSTED_USER_IDS=

# Searches per day for everyone else, per user. 0 disables public search entirely. Optional, default 5.
# The day boundary follows TZ.
PUBLIC_DAILY_PER_USER=5

# Searches per day for all non-trusted users together. 0 disables public search. Optional, default 120.
PUBLIC_DAILY_TOTAL=120

# Inline queries are charged once per user per this window. It exists because Telegram sends an inline
# query on every keystroke, which would burn the daily limit in one search. Optional, default 10s.
INLINE_CHARGE_WINDOW=10s

# Contact shown when a user hits the daily limit. Optional, default empty. Example: @your_username
ADMIN_CONTACT=

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------

# Fallback language when the user's Telegram language is not available. Shipped: en, ru. Optional, default en.
DEFAULT_LANG=en

# Time zone (IANA name) for daily limits and logs. Optional, default UTC. Example: Europe/Amsterdam
TZ=UTC

# SQLite database path (cache and counters). Optional, default: data/bot.db next to the executable.
# In Docker it is /data/bot.db, set by the image; keep /data mounted to survive restarts.
# DB_PATH=/data/bot.db

# YAML config file, an alternative to these variables (they override it); a missing file is fine. Optional, default: config.yml next to the executable
# (in Docker: /config/config.yml).
# CONFIG_FILE=/config/config.yml

# Log level: debug, info, warn, error. Optional, default info. Debug logs every HTTP call and user step
# (never tokens).
LOG_LEVEL=info
